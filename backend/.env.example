# ==============================================================================
# Airplane Ticket Management System - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
# Display name of the application displayed in OpenAPI/Swagger documentation
APP_NAME="Airplane Ticket Management System"

# Environment runtime mode (e.g., 'development', 'staging', 'production')
ENVIRONMENT=development

# Enable debug mode (reloads on changes, lowers bcrypt cost factor for high-speed seeding/tests)
DEBUG=True


# ------------------------------------------------------------------------------
# 2. Direct PostgreSQL Database Configuration (Port 5432)
# ------------------------------------------------------------------------------
# PostgreSQL credentials and network location for direct engine connections
# (used for schema migrations via Alembic, high-speed streaming COPY seeding, and backups)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airplane_tickets

# PostgreSQL synchronous commit mode ('on' for production durability, 'off' for ultra-low WSL2/testing commit latency)
POSTGRES_SYNCHRONOUS_COMMIT=on


# ------------------------------------------------------------------------------
# 3. PgBouncer High-Concurrency Connection Pooler (Port 6432)
# ------------------------------------------------------------------------------
# When enabled (True), application queries route through PgBouncer in transaction
# pooling mode rather than direct Postgres, supporting thousands of concurrent clients.
USE_PGBOUNCER=True
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

# Maximum number of concurrent incoming client connections PgBouncer allows
PGBOUNCER_MAX_CLIENT_CONN=5000

# Default number of server connections PgBouncer maintains per database/user
PGBOUNCER_DEFAULT_POOL_SIZE=50

# Minimum pool size maintained during idle periods
PGBOUNCER_MIN_POOL_SIZE=10

# Extra emergency connections opened if all pool connections are in use
PGBOUNCER_RESERVE_POOL_SIZE=5


# ------------------------------------------------------------------------------
# 4. Async Database URL (SQLAlchemy 2.0 AsyncPG)
# ------------------------------------------------------------------------------
# PostgreSQL asyncpg connection URL. In transaction pooling mode (PgBouncer),
# asyncpg MUST use statement_cache_size=0 to avoid prepared statement conflicts across clients.
# Defaults dynamically to PgBouncer host/port if omitted and USE_PGBOUNCER=True.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:6432/airplane_tickets


# ------------------------------------------------------------------------------
# 5. Redis Configuration (Cache-Aside, Distributed Locks, & Write Stream)
# ------------------------------------------------------------------------------
# Network coordinates for Redis service
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Redis memory ceiling and eviction policy for Cache-Aside pattern
# 'allkeys-lru' ensures that once the memory ceiling is reached, least recently
# used cache keys are automatically evicted to prevent OOM errors.
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Redis Stream name used to decouple HTTP ingestion from direct database writes
REDIS_STREAM_WRITE_NAME=stream:db_writes

# Redis Consumer Group name for worker processes consuming write events
REDIS_STREAM_CONSUMER_GROUP=db_writers

# Maximum connection pool capacity for async Redis client (dynamically scaled under benchmark load)
REDIS_MAX_CONNECTIONS=1000


# ------------------------------------------------------------------------------
# 6. Stream Worker Dynamic Micro-Batching Configuration
# ------------------------------------------------------------------------------
# The Stream Worker consumes write events from Redis Stream and commits them
# to PostgreSQL via PgBouncer. Dynamic micro-batching adapts behavior in real-time
# based on Redis Stream consumer group backlog (lag):
#
# - Low Queue Depth (lag <= STREAM_WORKER_QUEUE_DEPTH_THRESHOLD):
#   Flushes immediately with minimal batch size (STREAM_WORKER_MIN_BATCH_SIZE)
#   and 0 ms accumulation delay to achieve sub-millisecond queue wait times and
#   minimum end-to-end latency for individual user requests.
#
# - Rising Queue Depth (lag > STREAM_WORKER_QUEUE_DEPTH_THRESHOLD):
#   Switches to batching mode up to STREAM_WORKER_MAX_BATCH_SIZE messages,
#   accumulating within STREAM_WORKER_BATCH_TIMEOUT_MS to maximize transaction
#   throughput, amortize WAL fsyncs, and minimize PgBouncer connection overhead.

# Minimum number of messages processed per flush cycle when queue depth is low
# Fallback default: 1
STREAM_WORKER_MIN_BATCH_SIZE=1

# Maximum batch size aggregated into a single PostgreSQL transaction during traffic surges
# Fallback default: 50 (aliases accepted: BATCH_SIZE, STREAM_BATCH_MAX_SIZE)
STREAM_WORKER_MAX_BATCH_SIZE=50

# Backlog lag threshold in Redis Stream to toggle between immediate flush and batching mode
# If unconsumed queue depth <= threshold: immediate flush mode (0 ms wait).
# If unconsumed queue depth > threshold: micro-batching mode active.
# Fallback default: 5 (aliases accepted: QUEUE_DEPTH_THRESHOLD, STREAM_BATCH_QUEUE_DEPTH_THRESHOLD)
STREAM_WORKER_QUEUE_DEPTH_THRESHOLD=5

# Maximum accumulation window (in milliseconds) to gather messages into a batch during traffic surges
# Bypassed (0 ms) when queue depth is low.
# Fallback default: 10 (aliases accepted: FLUSH_TIMEOUT_MS, STREAM_BATCH_TIMEOUT_MS)
STREAM_WORKER_BATCH_TIMEOUT_MS=10

# Time (in milliseconds) XREADGROUP blocks waiting for incoming messages when stream is idle
# Fallback default: 1000 (aliases accepted: BLOCK_MS, STREAM_BATCH_BLOCK_MS)
STREAM_WORKER_BLOCK_MS=1000

# Worker flush strategy: 'dynamic' (adaptive), 'both' (size + timeout), 'size', or 'timeout'
# Fallback default: dynamic
STREAM_WORKER_FLUSH_STRATEGY=dynamic


# ------------------------------------------------------------------------------
# 7. Worker Concurrency & Decoupled Architecture
# ------------------------------------------------------------------------------
# Number of Stream Worker consumer instances spawned by the dedicated worker process.
# Recommended sweet spot on WSL2/multi-core: 4
# Fallback default: 4 (aliases accepted: STREAM_WORKERS, STREAM_WORKER_CONCURRENCY, WORKERS_COUNT)
STREAM_WORKERS_COUNT=4

# Mode toggle:
# False = decoupled mode (worker runs in dedicated container/process)
# True = embedded mode (FastAPI launches worker inside lifespan for single-process local dev)
# Fallback default: False
RUN_EMBEDDED_WORKER=False

# API service port
API_PORT=8000

# Number of Uvicorn worker processes to spawn for the FastAPI application.
# Spreading requests across multiple CPU cores prevents event loop starvation during concurrency spikes.
# Fallback default: 4 (aliases accepted: UVICORN_WORKERS, FASTAPI_WORKERS, APP_WORKERS)
API_WORKERS=4

# Bcrypt Password Hashing Work Factor (Rounds)
# Fallback default: 12 for production; 6 or 4 for high-scale load testing to prevent CPU starvation
# (aliases accepted: PASSWORD_BCRYPT_ROUNDS, HASH_ROUNDS, BCRYPT_SALT_ROUNDS)
BCRYPT_ROUNDS=12


# ------------------------------------------------------------------------------
# 8. MinIO Document Vault (S3 Compatible Storage)
# ------------------------------------------------------------------------------
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=tickets
MINIO_SECURE=False


# ------------------------------------------------------------------------------
# 9. Rate Limiting Configuration (Redis Sliding Window Counter)
# ------------------------------------------------------------------------------
# Master switch for API rate limiting across endpoints (True = active, False = bypassed)
# Fallback default: True (aliases accepted: ENABLE_RATE_LIMIT, RATE_LIMITING_ENABLED)
RATE_LIMIT_ENABLED=True

# Maximum number of requests permitted per client IP & path within the sliding window
# Fallback default: 120 (aliases accepted: RATE_LIMIT_REQUESTS, RATE_LIMIT_RPM, RATE_LIMIT_PER_MINUTE)
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Duration of the sliding window in seconds
# Fallback default: 60 (aliases accepted: RATE_LIMIT_WINDOW, RATE_LIMIT_WINDOW_SEC)
RATE_LIMIT_WINDOW_SECONDS=60


# ------------------------------------------------------------------------------
# 10. Nginx High-Concurrency Reverse Proxy & Load Balancer (Port 80)
# ------------------------------------------------------------------------------
# Public port exposed on host machine for incoming HTTP client traffic
# Fallback default: 80 (aliases accepted: HTTP_PORT, PROXY_PORT)
NGINX_PORT=80

# Number of worker processes ('auto' matches host CPU cores)
# Fallback default: auto
NGINX_WORKER_PROCESSES=auto

# Maximum simultaneous connections per worker process for high-concurrency workloads
# Fallback default: 4096 (aliases accepted: NGINX_CONNECTIONS, WORKER_CONNECTIONS)
NGINX_WORKER_CONNECTIONS=4096

# Maximum open file descriptors allowed for worker processes
# Fallback default: 65536
NGINX_WORKER_RLIMIT_NOFILE=65536

# Maximum client request body size permitted (e.g. for profile/document uploads)
# Fallback default: 20m (aliases accepted: CLIENT_MAX_BODY_SIZE)
NGINX_CLIENT_MAX_BODY_SIZE=20m

# HTTP Keep-Alive connection timeout in seconds
# Fallback default: 65
NGINX_KEEPALIVE_TIMEOUT=65

# Upstream proxy connection timeout to FastAPI backend
# Fallback default: 10s
NGINX_PROXY_CONNECT_TIMEOUT=10s

# Upstream proxy read timeout from FastAPI backend
# Fallback default: 60s
NGINX_PROXY_READ_TIMEOUT=60s

# Upstream proxy send timeout to FastAPI backend
# Fallback default: 60s
NGINX_PROXY_SEND_TIMEOUT=60s

# Number of idle keepalive connections maintained to upstream FastAPI pool
# Fallback default: 64 (aliases accepted: UPSTREAM_KEEPALIVE)
NGINX_UPSTREAM_KEEPALIVE=64

# Gzip compression master toggle ('on' or 'off')
# Fallback default: on
NGINX_GZIP_ENABLED=on

# Gzip compression level (1-9)
# Fallback default: 5
NGINX_GZIP_COMP_LEVEL=5

# Access log toggle ('on' or 'off'; toggle to 'off' for extreme benchmark runs)
# Fallback default: on
NGINX_ACCESS_LOG=on

# Maximum simultaneous active connections allowed from a single client IP address
# Fallback default: 100 (aliases accepted: LIMIT_CONN_PER_IP, NGINX_CONN_LIMIT_PER_IP)
# (Note: For single-host high-concurrency benchmarks like Locust, raise to match virtual user count e.g. 2000)
NGINX_LIMIT_CONN_PER_IP=100

# Maximum simultaneous active connections allowed globally across the entire server
# Fallback default: 2000 (aliases accepted: LIMIT_CONN_GLOBAL, NGINX_CONN_LIMIT_GLOBAL)
NGINX_LIMIT_CONN_GLOBAL=2000

# HTTP status code returned to client when connection limit is reached (e.g. 429 Too Many Requests or 503)
# Fallback default: 429 (aliases accepted: LIMIT_CONN_STATUS, NGINX_CONN_LIMIT_STATUS)
NGINX_LIMIT_CONN_STATUS=429

# Log level for connection limiting events ('warn', 'error', 'notice', 'info')
# Fallback default: warn (aliases accepted: LIMIT_CONN_LOG_LEVEL)
NGINX_LIMIT_CONN_LOG_LEVEL=warn



