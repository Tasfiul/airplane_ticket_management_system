upstream fastapi_app {
    server ${NGINX_API_HOST}:${NGINX_API_PORT};
    keepalive ${NGINX_UPSTREAM_KEEPALIVE};
}

upstream minio_s3 {
    server ${NGINX_MINIO_HOST}:${NGINX_MINIO_PORT};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name localhost _;

    # Client body and header timeouts
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # Root API and application traffic proxy to FastAPI
    location / {
        proxy_pass http://fastapi_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_send_timeout ${NGINX_PROXY_SEND_TIMEOUT};

        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
    }

    # Proxy to MinIO Document Vault (e.g. for direct downloads / webhooks)
    location /minio/ {
        proxy_pass http://minio_s3/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    }

    # Dedicated Healthcheck Endpoint proxying to FastAPI backend health
    location /health {
        proxy_pass http://fastapi_app/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Internal Nginx Status Endpoint for connection monitoring
    location /nginx_status {
        stub_status on;
        access_log off;
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
    }
}
